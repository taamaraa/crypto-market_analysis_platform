# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.


# ---------------------------------------------------------------- warehouse
# The analytical Postgres database that dbt builds into. Any Postgres works;
# a managed one such as Neon needs DB_SSLMODE=require.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=raw_data
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer


# ------------------------------------------------------ airflow metadata db
# Airflow's own bookkeeping database, running in the local postgres container.
# Unrelated to the warehouse above.

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# Login for the Airflow web UI at http://localhost:8081
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=

# Encrypts connections and variables stored by Airflow. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=


# -------------------------------------------------------------- data source
# Alpha Vantage supplies the stock prices. Free key:
#   https://www.alphavantage.co/support/#api-key
# CoinGecko and Binance are used without authentication.

ALPHA_API_KEY=


# ------------------------------------------------------------------- alerts
# Used by scripts/alerts.py to email newly triggered market alerts.
# With Gmail this must be an app password, not the account password.
# Leaving these empty disables sending; the alerts are still logged.

SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=

# Optional. Defaults shown.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# ALERT_EMAIL=<falls back to SMTP_MAIL_FROM>


# --------------------------------------------------------------- ai summary
# Used by scripts/ai_summary.py. Free key from Google AI Studio:
#   https://aistudio.google.com/apikey
# Optional -- without it the task writes a deterministic template summary
# built from the same numbers, so the pipeline never fails.

GEMINI_API_KEY=

# Optional. A "-latest" alias avoids the model name going stale.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_TIMEOUT=30
